#!/bin/bash
# subocr — OCR HDMV PGS subs from .mkv to external .srt via Apple Vision.
# Thin wrapper that ensures Homebrew tools are on PATH and execs the pyobjc venv.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
VENV="${SUBOCR_VENV:-$HOME/.local/share/subocr/venv}"
if [ -x "$VENV/bin/python" ]; then
    exec "$VENV/bin/python" -m burndvd.cli.subocr "$@"
fi
exec python3 -m burndvd.cli.subocr "$@"
