        if [ -n "$CONTRACT_JSON" ]; then
            CONTRACT_RECOGNIZED=1
            read -r DEFAULT_EP EXPECTED_DISC_EPISODES EXPECTED_EPISODES CONTRACT_DISC EXPECTED_TITLE_IDS \
                < <(printf '%s' "$CONTRACT_JSON" | python3 -c 'import json,sys
d=json.load(sys.stdin)
print(d["episode_start"], d["expected_disc_episodes"], d["expected_episodes"], d["disc"], json.dumps(d["expected_title_ids"],separators=(",",":")))')
            END_EP=$((DEFAULT_EP + EXPECTED_DISC_EPISODES - 1))
            EXPECTED_PHYSICAL_DISC="$CONTRACT_DISC"
            echo "Episode contract: disc $CONTRACT_DISC -> S$(printf '%02d' "$SEASON")E$(printf '%02d' "$DEFAULT_EP")-E$(printf '%02d' "$END_EP") (${EXPECTED_EPISODES} total)."

            for numeric in "$EXPECTED_EPISODES" "$DEFAULT_EP" "$EXPECTED_DISC_EPISODES" "$EXPECTED_PHYSICAL_DISC"; do
                [[ "$numeric" =~ ^[0-9]+$ ]] && [ "$numeric" -gt 0 ] || {
                    echo "burndvd: episode contract values must be positive integers." >&2
                    exit 64
                }
            done
            if [ "$END_EP" -gt "$EXPECTED_EPISODES" ]; then
                echo "burndvd: disc range E$DEFAULT_EP-E$END_EP exceeds season total $EXPECTED_EPISODES." >&2
                exit 64
            fi

            select_tv_output_mode_for_range \
                "$SEASON_DIR" "$TITLE" "$SEASON" \
                "$DEFAULT_EP" "$END_EP" "$EXPECTED_EPISODES" \
                "$CONTRACT_RECOGNIZED" || exit $?
            append_ripqueue_mode_arg_once "--auto-rerip-review"
        else
            DEFAULT_EP=1
            SCAN_SEASON_DIR=$(resolve_nas_dir "$SEASON_DIR")
            WAIT_SCAN_S=0
            [ -t 0 ] && WAIT_SCAN_S=120
            NEXT_EP_JSON=$(run_metadata next-episode \
                --title "$TITLE" \
                --season "$SEASON" \
                --target-root "$ROOT" \
                --season-dir "$SCAN_SEASON_DIR" \
                --media-smb-root "$MEDIA_SMB_ROOT" \
                --media-nfs-root "$MEDIA_NFS_ROOT" \
                --wait-scan-s "$WAIT_SCAN_S" || true)
            if [ -n "$NEXT_EP_JSON" ]; then
                IFS=$'\t' read -r DEFAULT_EP AUTO_EP_NOTE < <(printf '%s' "$NEXT_EP_JSON" | python3 -c 'import json,sys
d=json.load(sys.stdin)
ne=int(d.get("next_episode") or 1)
nh=int(d.get("nas_highest") or 0)
res=d.get("reservations") or []
parts=[]
if nh > 0:
    parts.append(f"NAS ends at E{nh:02d}")
for r in res:
    parts.append("active rip pid %s reserving %s ep(s): E%02d-E%02d" % (r["pid"], r["episode_count"], r["episode_start"], r["episode_end"]))
note = " + ".join(parts) if res else ""
print(f"{ne}\t{note}")' 2>/dev/null || printf '1\t\n')
                if [ -n "${AUTO_EP_NOTE:-}" ]; then
                    printf '\033[32mAuto episode start: %s (%s)\033[0m\n' "$DEFAULT_EP" "$AUTO_EP_NOTE"
                fi
            elif [ -d "$SCAN_SEASON_DIR" ]; then
                HIGHEST_EP=$( (find "$SCAN_SEASON_DIR" -maxdepth 1 -type f -size +0 \
                    -name '*.mkv' -print 2>/dev/null \
                    | grep -oE "S0*${SEASON}E[0-9]+" \
                    | grep -oE 'E[0-9]+' | tr -d 'E' \
                    | sort -n | tail -1) || true )
                if [ -n "$HIGHEST_EP" ]; then
                    DEFAULT_EP=$(( 10#$HIGHEST_EP + 1 ))
                fi
            fi
        fi

        warn_concurrent_rip "$TITLE" "$SEASON" "$ROOT"
        prompt_value EP_START "Episode start [$DEFAULT_EP]: " "$DEFAULT_EP" 1
        if [ "$CONTRACT_RECOGNIZED" = "1" ] && [ "$EP_START" != "$DEFAULT_EP" ]; then
            echo "burndvd: episode start is contract-bound to $DEFAULT_EP; refusing $EP_START." >&2
            exit 65
        fi
        ;;
    movie)
        case "$FORMAT" in
            4K)     ROOT="$NAS_ROOT/Movies 4K/$TITLE"; MOVIE_BASE="$NAS_ROOT/Movies 4K" ;;
            BD|DVD) ROOT="$NAS_ROOT/Movies/$TITLE";    MOVIE_BASE="$NAS_ROOT/Movies" ;;
            *) echo "burndvd: unknown format '$FORMAT' (4K/BD/DVD)." >&2; exit 1 ;;
        esac

        if movie_volume_is_multipart "$VOLUME"; then
            echo
            echo "Multipart movie label detected; skipping the double-feature pre-scan."
            echo "The rip will keep its PT/PART suffix and open the drive only once."
        else
            echo
            echo "Scanning disc titles for a possible double feature..."
            SCAN_JSON=$("$RIPQUEUE_PY" --scan --device "disc:$DISC_INDEX" 2>/dev/null || echo "[]")
            NFEAT=$(printf '%s' "$SCAN_JSON" \
                | python3 -c 'import sys,json
try: print(sum(1 for t in json.load(sys.stdin) if t.get("feature")))
except Exception: print(0)' 2>/dev/null || echo 0)
            if [ "${NFEAT:-0}" -ge 2 ]; then
                echo
                echo "Found $NFEAT feature-length titles on this disc:"
                printf '%s' "$SCAN_JSON" | python3 -c 'import sys,json
for t in json.load(sys.stdin):
    if t.get("feature"):
        print("  t%02d  %8s  %10s  %s" % (t["id"], t["dur"], t["size"], t["name"]))'
                echo
                prompt_value DF "Treat as a double feature (rip each as its own movie)? [y/N] " "n"
                if [[ "$DF" =~ ^[Yy] ]]; then
                    FEAT_IDS=$(printf '%s' "$SCAN_JSON" | python3 -c 'import sys,json
print(" ".join(str(t["id"]) for t in json.load(sys.stdin) if t.get("feature")))')
                    FEAT_PAIRS=()
                    echo "Name each movie (include year, e.g. \"Death Proof (2007)\"):"
                    for fid in $FEAT_IDS; do
                        DUR=$(printf '%s' "$SCAN_JSON" | python3 -c "import sys,json
print(next(t['dur'] for t in json.load(sys.stdin) if t['id']==$fid))")
                        MNAME=""
                        while :; do
                            prompt_value MNAME "  t$(printf '%02d' "$fid") ($DUR): " "" 1
                            MNAME=$(run_metadata normalize-movie "$MNAME")
                            if run_metadata has-year "$MNAME"; then
                                break
                            fi
                            echo "  (movie name must end in a four-digit year — or Ctrl-C to abort)"
                        done
                        FEAT_PAIRS+=("$fid"$'\t'"$MNAME")
                    done
                    FEATURES_JSON=$(python3 -c 'import sys,json
pairs=[a.split("\t",1) for a in sys.argv[1:]]
print(json.dumps([{"title_id":int(i),"name":n} for i,n in pairs]))' "${FEAT_PAIRS[@]}")
                    TYPE="double-feature"
                    ROOT="$MOVIE_BASE"
                    echo
                    echo "Double feature → ${#FEAT_PAIRS[@]} movies under $ROOT/"
                fi
            fi
        fi
        ;;
    *)
        echo "burndvd: unknown type '$TYPE' (expected 'movie', 'tv', or 'tv-season')." >&2
        exit 1
        ;;
esac

QUEUE=$(mktemp -t burndvd-queue.XXXX.csv)
run_metadata write-queue \
    --output "$QUEUE" \
    --title "$TITLE" \
    --type "$TYPE" \
    --season "$SEASON" \
    --episode-start "$EP_START" \
    --expected-episodes "$EXPECTED_EPISODES" \
    --expected-disc-episodes "$EXPECTED_DISC_EPISODES" \
    --expected-title-ids "$EXPECTED_TITLE_IDS" \
    --expected-physical-disc "$EXPECTED_PHYSICAL_DISC" \
    --target-root "$ROOT" \
    --format "$FORMAT" \
    --notes "auto-built from $VOLUME" \
    --features "$FEATURES_JSON"

python3 "$RIPQUEUE_PY" --validate-queue "$QUEUE" >/dev/null

VOLUME_SLUG=$(printf '%s' "$VOLUME" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9-')
LOG="$LOG_DIR/burndvd-${VOLUME_SLUG:-disc}-$(date +%Y%m%dT%H%M%S).log"

if [ -d "/Volumes/$VOLUME" ] && drutil status -drive "$DRUTIL_INDEX" 2>/dev/null | grep -q "Type: DVD"; then
    echo "Unmounting DVD volume /Volumes/$VOLUME so MakeMKV can read it (disc stays in tray)."
    diskutil unmount "/Volumes/$VOLUME" >/dev/null 2>&1 \
        || echo "burndvd: unmount returned non-zero; MakeMKV may still be locked out." >&2
fi

echo
echo "Queue: $QUEUE"
echo "Target: $ROOT"
echo "Log:    $LOG"
echo

BURNDVD_DRUTIL_DRIVE="$DRUTIL_INDEX" BURNDVD_DRIVE_DEVICE="/dev/$DEVICE" \
    BURNDVD_DRIVE_SERIAL="$DRIVE_SERIAL" \
    nohup "$WRAPPER_PATH" --internal-pty-run "$LOG" \
    caffeinate -dimsu "$RIPQUEUE_PY" --queue "$QUEUE" --state "$STATE" \
    --device "disc:$DISC_INDEX" --non-interactive --on-fail=retry --verify \
    ${RIPQUEUE_MODE_ARGS[@]+"${RIPQUEUE_MODE_ARGS[@]}"} \
    </dev/null >/dev/null 2>&1 &
RIP_LAUNCHER=$!
disown

echo "Rip launched detached (pid $RIP_LAUNCHER). Tailing log;"
echo "When the rip finishes, the disc auto-ejects and the tail exits."
echo "Ctrl-C anytime to detach early; the rip keeps running either way."
echo "Reattach later with: tail -f '$LOG'"
echo "Status check:        checkrip"

SESSION_PID_FILE="$HOME/.cache/burndvd/session-caffeinate.pid"
mkdir -p "$(dirname "$SESSION_PID_FILE")"
if [ -f "$SESSION_PID_FILE" ]; then
    OLD_CAFF=$(cat "$SESSION_PID_FILE" 2>/dev/null || true)
    if [ -n "$OLD_CAFF" ] && kill -0 "$OLD_CAFF" 2>/dev/null; then
        kill "$OLD_CAFF" 2>/dev/null && \
            echo "Killed previous session-caffeinate (pid $OLD_CAFF)."
    fi
fi
caffeinate -du -t 21600 </dev/null >/dev/null 2>&1 &
disown
CAFF_PID=$!
echo "$CAFF_PID" > "$SESSION_PID_FILE"
echo "Lock prevention: caffeinate -du for 6h (pid $CAFF_PID). Refreshed on every burndvd run."

echo
sleep 1

tail -f "$LOG" &
TAIL_PID=$!
trap 'kill "$TAIL_PID" 2>/dev/null; exit 130' INT TERM

RIPQUEUE_SEEN=0
LAUNCH_WAIT_S=0
while [ "$LAUNCH_WAIT_S" -lt 30 ]; do
    if pgrep -if "python.*(ripqueue\.py|burndvd-queue).*$STATE" >/dev/null 2>&1; then
        RIPQUEUE_SEEN=1
        break
    fi
    [ -f "${STATE}.exit" ] && break
    sleep 1
    LAUNCH_WAIT_S=$((LAUNCH_WAIT_S + 1))
done

if [ "$RIPQUEUE_SEEN" = "1" ]; then
    while pgrep -if "python.*(ripqueue\.py|burndvd-queue).*$STATE" >/dev/null 2>&1; do
        sleep 10
    done
fi

EXIT_WAIT_S=0
while [ ! -f "${STATE}.exit" ] && [ "$EXIT_WAIT_S" -lt 10 ]; do
    sleep 1
    EXIT_WAIT_S=$((EXIT_WAIT_S + 1))
done

sleep 3
kill "$TAIL_PID" 2>/dev/null || true
wait "$TAIL_PID" 2>/dev/null || true
trap - INT TERM

RIP_EXIT_CODE=1
RIP_EXIT_REASON="unknown"
if [ -f "${STATE}.exit" ]; then
    RIP_EXIT_CODE=$(python3 -c "import json,sys
try: d=json.load(open(sys.argv[1])); print(d.get('exit_code', 1))
except Exception: print(1)" "${STATE}.exit" 2>/dev/null || echo 1)
    RIP_EXIT_REASON=$(python3 -c "import json,sys
try: d=json.load(open(sys.argv[1])); print(d.get('reason', 'unknown'))
except Exception: print('unknown')" "${STATE}.exit" 2>/dev/null || echo unknown)
fi
[[ "$RIP_EXIT_CODE" =~ ^[0-9]+$ ]] || RIP_EXIT_CODE=1

case "$RIP_EXIT_CODE" in
    0)
        echo
        echo "✓ Rip complete (exit 0)."
        append_rip_summary "$VOLUME" "SUCCESS" "$RIP_EXIT_CODE" \
            "$RIP_EXIT_REASON" "$LOG"
        ;;
    130)
        echo
        echo "Rip interrupted (Ctrl-C). State on disk is current at $STATE."
        append_rip_summary "$VOLUME" "INTERRUPT" "$RIP_EXIT_CODE" \
            "$RIP_EXIT_REASON" "$LOG"
        ;;
    *)
        echo
        echo "✗ Rip FAILED (exit $RIP_EXIT_CODE, reason: $RIP_EXIT_REASON)" >&2
        echo "  Log: $LOG" >&2
        echo "  NOT ejecting — leaving disc in drive so you can decide." >&2
        append_rip_summary "$VOLUME" "FAILED" "$RIP_EXIT_CODE" \
            "$RIP_EXIT_REASON" "$LOG"
        slack_post_failure ":x: *Rip FAILED* — \`$VOLUME\` (exit $RIP_EXIT_CODE, $RIP_EXIT_REASON). Disc left in drive. Log: \`$(basename "$LOG")\`"
        ;;
esac

if [ "$RIP_EXIT_CODE" = "0" ]; then
    if [ -x "$HOME/.local/bin/ejectdisc" ]; then
        echo "Ejecting disc."
        "$HOME/.local/bin/ejectdisc" "$DRUTIL_INDEX" || echo "WARN: eject failed (drutil returned non-zero)" >&2
    elif [ -x "$SCRIPT_DIR/ejectdisc" ]; then
        echo "Ejecting disc."
        "$SCRIPT_DIR/ejectdisc" "$DRUTIL_INDEX" || echo "WARN: eject failed (drutil returned non-zero)" >&2
    elif command -v ejectdisc >/dev/null 2>&1; then
        echo "Ejecting disc."
        ejectdisc "$DRUTIL_INDEX" || echo "WARN: eject failed (drutil returned non-zero)" >&2
    fi
fi

exit "$RIP_EXIT_CODE"
