#!/bin/bash
# burndvd — smart single-disc wrapper around burndvd-queue / ripqueue.py.
#
# Usage:
#   burndvd                       # detect inserted disc + 1-3 prompts (Enter to accept defaults)
#   burndvd --rerip-review        # capture a known TV disc into isolated out-of-library review
#   burndvd --queue queue.csv ... # pass-through to burndvd-queue for multi-disc CSV mode
#
# Single-disc mode runs the rip detached (nohup + script PTY) and tails the log
# in the foreground. Ctrl-C detaches only the tail; the rip keeps running.
# Check status anytime with `checkrip`.

set -euo pipefail

WRAPPER_PATH=$(python3 -c 'import os,sys
print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")
SCRIPT_DIR=$(dirname "$WRAPPER_PATH")

# Resolve ripqueue & metadata commands: honor explicit env overrides first,
# then sibling scripts (legacy compat), then installed `burndvd` package CLIs.
if [ -n "${BURNDVD_RIPQUEUE_PY:-}" ]; then
    RIPQUEUE_PY="$BURNDVD_RIPQUEUE_PY"
elif [ -f "$SCRIPT_DIR/ripqueue.py" ]; then
    RIPQUEUE_PY="$SCRIPT_DIR/ripqueue.py"
elif [ -x "$SCRIPT_DIR/burndvd-queue" ]; then
    RIPQUEUE_PY="$SCRIPT_DIR/burndvd-queue"
elif command -v burndvd-queue >/dev/null 2>&1; then
    RIPQUEUE_PY=$(command -v burndvd-queue)
elif [ -f "$HOME/scripts/ripqueue.py" ]; then
    RIPQUEUE_PY="$HOME/scripts/ripqueue.py"
else
    RIPQUEUE_PY="$SCRIPT_DIR/ripqueue.py"
fi

METADATA_PY="${BURNDVD_METADATA_PY:-}"
if [ -z "$METADATA_PY" ] && [ -f "$SCRIPT_DIR/burndvd_metadata.py" ]; then
    METADATA_PY="$SCRIPT_DIR/burndvd_metadata.py"
fi

run_metadata() {
    if [ -n "$METADATA_PY" ] && [ -f "$METADATA_PY" ]; then
        python3 "$METADATA_PY" "$@"
    elif [ -x "$SCRIPT_DIR/burndvd-metadata" ]; then
        "$SCRIPT_DIR/burndvd-metadata" "$@"
    elif command -v burndvd-metadata >/dev/null 2>&1; then
        burndvd-metadata "$@"
    else
        PYTHONPATH="$SCRIPT_DIR/../src${PYTHONPATH:+:$PYTHONPATH}" \
            python3 -m burndvd.cli.metadata "$@"
    fi
}

MEDIA_SMB_ROOT="${BURNDVD_MEDIA_ROOT:-/Volumes/Media}"
MEDIA_NFS_ROOT="${BURNDVD_NFS_MEDIA_ROOT:-/private/nas/media}"
LOG_DIR="${BURNDVD_LOG_DIR:-$HOME/logs}"

# Run a command under script(1)'s pseudo-terminal while deliberately keeping
# its stdin open until the child exits (no immortal sleep feeder).
run_logged_pty() {
    [ "$#" -ge 2 ] || { echo "burndvd: internal pty runner needs LOG COMMAND..." >&2; return 64; }
    local log_path="$1"
    shift
    python3 -c 'import select, sys
p = select.poll()
p.register(sys.stdout.fileno(), select.POLLERR | select.POLLHUP)
p.poll()' \
        | /usr/bin/script -q "$log_path" "$@"
}

if [ "${1:-}" = "--internal-pty-run" ]; then
    shift
    run_logged_pty "$@" || exit $?
    exit 0
fi

prompt_value() {
    local target_name="$1"
    local prompt_text="$2"
    local default_value="${3:-}"
    local required="${4:-0}"
    local value=""

    if IFS= read -r -p "$prompt_text" value; then
        :
    else
        value="$default_value"
        if [ -n "$default_value" ]; then
            printf '\nburndvd: stdin ended; using default %q.\n' "$default_value" >&2
        else
            printf '\nburndvd: stdin ended and this prompt has no default.\n' >&2
        fi
    fi
    [ -n "$value" ] || value="$default_value"
    if [ "$required" = "1" ] && [ -z "$value" ]; then
        echo "burndvd: a value is required for: $prompt_text" >&2
        return 64
    fi
    printf -v "$target_name" '%s' "$value"
}

movie_volume_is_multipart() {
    local upper_label
    upper_label=$(printf '%s' "${1:-}" | tr '[:lower:]' '[:upper:]')
    [[ "$upper_label" =~ (^|[^[:alnum:]])(PT|PART)[._[:space:]-]*[0-9]{1,2}($|[^[:digit:]]) ]]
}

append_ripqueue_mode_arg_once() {
    local wanted="$1" existing
    for existing in ${RIPQUEUE_MODE_ARGS[@]+"${RIPQUEUE_MODE_ARGS[@]}"}; do
        [ "$existing" = "$wanted" ] && return 0
    done
    RIPQUEUE_MODE_ARGS+=("$wanted")
}

resolve_nas_dir() {
    local p="$1" alt=""
    if [ -d "$p" ]; then
        printf '%s\n' "$p"
        return 0
    fi
    case "$p" in
        "$MEDIA_SMB_ROOT"/*) alt="${MEDIA_NFS_ROOT}/${p#${MEDIA_SMB_ROOT}/}" ;;
        "$MEDIA_NFS_ROOT"/*) alt="${MEDIA_SMB_ROOT}/${p#${MEDIA_NFS_ROOT}/}" ;;
    esac
    if [ -n "$alt" ] && [ -d "$alt" ]; then
        printf '%s\n' "$alt"
        return 0
    fi
    printf '%s\n' "$p"
}

resolve_nas_root() {
    if [ -d "${MEDIA_NFS_ROOT}/TV Shows" ]; then
        printf '%s\n' "$MEDIA_NFS_ROOT"
    else
        printf '%s\n' "$MEDIA_SMB_ROOT"
    fi
}

select_tv_output_mode_for_range() {
    local season_dir="$1" title="$2" season="$3"
    local first_ep="$4" last_ep="$5" expected_episodes="$6"
    local contract_recognized="${7:-0}"
    local existing_ep overlap_ep=""
    local prefix entry base suffix

    [ "$TV_OUTPUT_MODE" = "normal" ] || return 0
    [[ "$season" =~ ^[0-9]+$ ]] && season=$((10#$season))
    [[ "$first_ep" =~ ^[0-9]+$ ]] && first_ep=$((10#$first_ep))
    [[ "$last_ep" =~ ^[0-9]+$ ]] && last_ep=$((10#$last_ep))
    [[ "$expected_episodes" =~ ^[0-9]+$ ]] && expected_episodes=$((10#$expected_episodes))
    season_dir=$(resolve_nas_dir "$season_dir")
    [ -d "$season_dir" ] || return 0

    prefix="${title} - S$(printf '%02d' "$season")E"
    for entry in "$season_dir"/*; do
        [ ! -L "$entry" ] && [ -f "$entry" ] && [ -s "$entry" ] || continue
        base="${entry##*/}"
        [ "${base:0:${#prefix}}" = "$prefix" ] || continue
        suffix="${base:${#prefix}}"
        [[ "$suffix" == *.mkv ]] || continue
        suffix="${suffix%.mkv}"
        [[ "$suffix" =~ ^[0-9]+$ ]] || continue
        existing_ep=$((10#$suffix))
        if [ "$existing_ep" -gt "$expected_episodes" ]; then
            echo "burndvd: season has E$existing_ep beyond authoritative total $expected_episodes; repair first." >&2
            return 65
        fi
        if [ "$existing_ep" -ge "$first_ep" ] && [ "$existing_ep" -le "$last_ep" ]; then
            [ -n "$overlap_ep" ] || overlap_ep="$existing_ep"
        fi
    done

    if [ -n "$overlap_ep" ]; then
        if [ "$contract_recognized" != "1" ]; then
            echo "burndvd: authoritative slot E$overlap_ep already exists, but this disc has no verified metadata contract." >&2
            echo "         Refusing automatic review; use --rerip-review only after checking the manual contract." >&2
            return 65
        fi
        TV_OUTPUT_MODE="review"
        append_ripqueue_mode_arg_once "--auto-rerip-review"
        echo "Existing authoritative slot E$overlap_ep detected."
        echo "Mode: protected review capture (published SxxExx files remain unchanged)."
    fi
}

show_usage() {
    cat <<'EOF'
burndvd — smart single-disc wrapper around burndvd-queue / ripqueue.py

Usage:
  burndvd [OPTS...]               Detect inserted disc, confirm 1-3 prompts, and rip detached
  burndvd --drive <diskN|serial>  Target a specific optical drive by device node or serial
  burndvd --watch --show TITLE --season N [OPTS...]
                                  Zero-babysit 2-drive box-set watch daemon
  burndvd --no-extras             Skip ripping TV bonus/extra titles shorter than TV_MIN_DUR_S
  burndvd --with-extras           Rip TV bonus/extra titles even when config sets no_extras=true
  burndvd --rerip-review          Capture a known TV disc into isolated out-of-library review
  burndvd --queue FILE [OPTS...]  Pass-through to burndvd-queue for multi-disc CSV queues
  burndvd doctor [--json]         Check binaries, optical drive, NAS mounts, space, and OCR
  burndvd -h | --help             Show this help message and exit without probing optical drives

Options:
  --drive <diskN|serial>          Target a specific physical drive (e.g. disk5 or DRVSER00001)
  --watch [OPTS...]               Run 2-drive box-set watch daemon (pass --watch --help for options)
  --no-extras                     Skip bonus/extra titles shorter than TV_MIN_DUR_S on TV discs
  --with-extras                   Override sticky config no_extras=true and rip extras
  --rerip-review                  Route a known TV disc to review quarantine (published SxxExx unchanged)
  --queue FILE [OPTS...]          Run multi-disc CSV queue via burndvd-queue (accepts burndvd-queue flags
                                  such as --non-interactive, --on-fail, --verify, --device, --no-eject,
                                  --no-subocr, --no-extras, --sync-move, --overwrite)
  -h, --help                      Print this usage summary and exit 0

Environment variables:
  BURNDVD_DRUTIL_DRIVE            1-based drutil -drive index exported to burndvd-queue
  BURNDVD_DRIVE_DEVICE            Verified /dev/diskN device node exported to burndvd-queue
  BURNDVD_DRIVE_SERIAL            Verified optical drive hardware serial exported to burndvd-queue
  BURNDVD_NO_EXTRAS               Set to 1 to skip TV bonus/extra titles by default
  BURNDVD_CONFIG                  User config file path (default: ~/.config/burndvd/config)
  BURNDVD_MEDIA_ROOT              SMB media library root (default: /Volumes/Media)
  BURNDVD_NFS_MEDIA_ROOT          NFS media library root (default: /private/nas/media)
  BURNDVD_LOG_DIR                 Log directory (default: ~/logs)
  BURNDVD_RIPQUEUE_PY             Override path to ripqueue.py / burndvd-queue
  BURNDVD_METADATA_PY             Override path to metadata helper
  BURNDVD_SLACK_WEBHOOK           Optional Slack incoming webhook URL for failure alerts
  BURNDVD_SLACK_TOKEN             Optional Slack bot token (paired with BURNDVD_SLACK_CHANNEL)
  BURNDVD_SLACK_CHANNEL           Optional Slack channel ID for failure alerts

Single-disc mode runs the rip detached (nohup + script PTY) and tails the log in the foreground.
Press Ctrl-C to detach the tail while leaving the rip running; check status anytime with `checkrip`.
EOF
}

if [ "${BURNDVD_LIBRARY_ONLY:-0}" = "1" ]; then
    return 0 2>/dev/null || exit 0
fi

HAS_QUEUE_ARG=0
for arg in "$@"; do
    if [ "$arg" = "--queue" ]; then
        HAS_QUEUE_ARG=1
        break
    fi
done

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    show_usage
    exit 0
fi
if [ "${1:-}" = "doctor" ]; then
    shift
    if [ -x "$SCRIPT_DIR/burndvd-doctor" ]; then
        exec "$SCRIPT_DIR/burndvd-doctor" "$@"
    fi
    if command -v burndvd-doctor >/dev/null 2>&1; then
        exec burndvd-doctor "$@"
    fi
    if [ -x "$SCRIPT_DIR/python3" ]; then
        exec "$SCRIPT_DIR/python3" -m burndvd.cli.doctor "$@"
    fi
    if [ -x "$HOME/.pyenv/shims/python3" ]; then
        PYTHONPATH="$SCRIPT_DIR/../src${PYTHONPATH:+:$PYTHONPATH}" \
            exec "$HOME/.pyenv/shims/python3" -m burndvd.cli.doctor "$@"
    fi
    PYTHONPATH="$SCRIPT_DIR/../src${PYTHONPATH:+:$PYTHONPATH}" \
        exec python3 -m burndvd.cli.doctor "$@"
fi
if [ "${1:-}" = "--watch" ] || [ "${1:-}" = "watch" ]; then
    shift
    if [ -x "$SCRIPT_DIR/python3" ]; then
        exec "$SCRIPT_DIR/python3" -m burndvd.cli.watch "$@"
    fi
    if [ -x "$HOME/.pyenv/shims/python3" ]; then
        PYTHONPATH="$SCRIPT_DIR/../src${PYTHONPATH:+:$PYTHONPATH}" \
            exec "$HOME/.pyenv/shims/python3" -m burndvd.cli.watch "$@"
    fi
    PYTHONPATH="$SCRIPT_DIR/../src${PYTHONPATH:+:$PYTHONPATH}" \
        exec python3 -m burndvd.cli.watch "$@"
fi
if [ "$HAS_QUEUE_ARG" = "0" ]; then
    for arg in "$@"; do
        if [ "$arg" = "-h" ] || [ "$arg" = "--help" ]; then
            show_usage
            exit 0
        fi
    done
fi

TV_OUTPUT_MODE="normal"
TARGET_DRIVE=""
RIPQUEUE_MODE_ARGS=()
case "${BURNDVD_NO_EXTRAS:-}" in
    1|true|TRUE|yes|YES) append_ripqueue_mode_arg_once "--no-extras" ;;
esac
if [ "$HAS_QUEUE_ARG" = "1" ]; then
    if [ "${1:-}" = "--rerip-review" ]; then
        TV_OUTPUT_MODE="review"
        append_ripqueue_mode_arg_once "--rerip-review"
        shift
    fi
else
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --rerip-review)
                TV_OUTPUT_MODE="review"
                append_ripqueue_mode_arg_once "--rerip-review"
                shift
                ;;
            --no-extras)
                append_ripqueue_mode_arg_once "--no-extras"
                shift
                ;;
            --with-extras)
                _filtered_args=()
                if [ "${#RIPQUEUE_MODE_ARGS[@]}" -gt 0 ]; then
                    for _ex in "${RIPQUEUE_MODE_ARGS[@]}"; do
                        [ "$_ex" = "--no-extras" ] && continue
                        _filtered_args+=("$_ex")
                    done
                fi
                RIPQUEUE_MODE_ARGS=(${_filtered_args[@]+"${_filtered_args[@]}"})
                append_ripqueue_mode_arg_once "--with-extras"
                shift
                ;;
            --drive)
                if [ "$#" -lt 2 ] || [ -z "${2:-}" ]; then
                    echo "burndvd: --drive requires a device (diskN) or drive serial." >&2
                    exit 64
                fi
                TARGET_DRIVE="$2"
                shift 2
                ;;
            --drive=*)
                TARGET_DRIVE="${1#--drive=}"
                if [ -z "$TARGET_DRIVE" ]; then
                    echo "burndvd: --drive requires a device (diskN) or drive serial." >&2
                    exit 64
                fi
                shift
                ;;
            *)
                echo "burndvd: unknown option '$1' (use --help for usage)." >&2
                exit 64
                ;;
        esac
    done
fi

mkdir -p "$LOG_DIR"

sweep_burndvd_orphans() {
    local state pid claim claim_state
    local states
    states=$(ps -Ao args= 2>/dev/null \
        | grep -oE -- "--state [^ ]+" \
        | awk '{print $2}' | tr -d "'\"" | sort -u \
        | grep -E "burndvd-state" || true)
    for state in $states; do
        pgrep -if "python.*(ripqueue\.py|burndvd-queue).*$state" >/dev/null 2>&1 && continue
        for pid in $(pgrep -f "$state" 2>/dev/null || true); do
            kill "$pid" 2>/dev/null || true
        done
        rm -f "${state}.exit" 2>/dev/null || true
    done
    find "$LOG_DIR" -maxdepth 1 -name "burndvd-*.log" -mtime +30 \
        -delete 2>/dev/null || true
    find "$LOG_DIR" -maxdepth 1 -name "subocr-postrip-*.log" -mtime +30 \
        -delete 2>/dev/null || true
    local claim_dir="$HOME/.cache/burndvd/drive-claims"
    if [ -d "$claim_dir" ]; then
        local claim_pid
        for claim in "$claim_dir"/serial-*.claim "$claim_dir"/dev-*.claim "$claim_dir"/disc-*.claim; do
            [ -d "$claim" ] || continue
            claim_pid=$(cat "$claim/pid" 2>/dev/null || true)
            if [ -n "$claim_pid" ] && [[ "$claim_pid" =~ ^[0-9]+$ ]] && kill -0 "$claim_pid" 2>/dev/null; then
                continue
            fi
            claim_state=$(cat "$claim/state" 2>/dev/null || true)
            if [ -n "$claim_state" ]; then
                pgrep -if "python.*(ripqueue\.py|burndvd-queue).*$claim_state" >/dev/null 2>&1 \
                    && continue
            else
                [ -z "$(find "$claim" -maxdepth 0 -mmin +5 2>/dev/null)" ] \
                    && continue
            fi
            rm -rf "$claim" 2>/dev/null || true
        done
    fi
}
sweep_burndvd_orphans

RIP_SUMMARY_LOG="$LOG_DIR/rip-summary.log"

# Optional Slack failure alerts via BURNDVD_SLACK_WEBHOOK (Incoming Webhook)
# or BURNDVD_SLACK_TOKEN + BURNDVD_SLACK_CHANNEL (Bot API). Silent no-op if unset.
slack_post_failure() {
    local text="$1"
    if [ -n "${BURNDVD_SLACK_WEBHOOK:-}" ]; then
        /usr/bin/curl -sS -m 10 -X POST "$BURNDVD_SLACK_WEBHOOK" \
            -H "Content-Type: application/json; charset=utf-8" \
            -d "$(python3 -c 'import json,sys; print(json.dumps({"text": sys.argv[1]}))' "$text")" \
            >/dev/null 2>&1 || true
        return 0
    fi
    local token="${BURNDVD_SLACK_TOKEN:-}"
    local channel="${BURNDVD_SLACK_CHANNEL:-}"
    if [ -z "$token" ] && [ -n "${BURNDVD_ENV_FILE:-}" ] && [ -f "$BURNDVD_ENV_FILE" ]; then
        token=$( (grep '^SLACK_BOT_TOKEN=' "$BURNDVD_ENV_FILE" 2>/dev/null \
            | cut -d= -f2- | tr -d '"' | tr -d "'") || true )
    fi
    [ -n "$token" ] && [ -n "$channel" ] || return 0
    /usr/bin/curl -sS -m 10 -X POST https://slack.com/api/chat.postMessage \
        -H "Authorization: Bearer $token" \
        -H "Content-Type: application/json; charset=utf-8" \
        -d "$(python3 -c 'import json,sys
print(json.dumps({"channel": sys.argv[1], "text": sys.argv[2], "unfurl_links": False}))' "$channel" "$text")" \
        >/dev/null 2>&1 || true
}

append_rip_summary() {
    local volume="$1" status="$2" exit_code="$3" reason="$4" log_path="$5"
    mkdir -p "$(dirname "$RIP_SUMMARY_LOG")"
    printf '%s\t%s\t%s\texit=%s\treason=%s\tlog=%s\n' \
        "$(date '+%Y-%m-%dT%H:%M:%S%z')" \
        "$status" \
        "${volume:-?}" \
        "$exit_code" \
        "$reason" \
        "$(basename "$log_path")" \
        >> "$RIP_SUMMARY_LOG" 2>/dev/null || true
}

warn_concurrent_rip() {
    local title="$1" season="$2" target_root="${3:-}"
    local pid cmdline state_file queue_file
    for pid in $(pgrep -if "python.*(ripqueue\.py|burndvd-queue)" 2>/dev/null || true); do
        [ "$pid" = "$$" ] && continue
        cmdline=$(ps -o args= -p "$pid" 2>/dev/null || true)
        [ -z "$cmdline" ] && continue
        state_file=$(printf '%s\n' "$cmdline" \
            | grep -oE -- "--state [^ ]+" | awk '{print $2}' | tr -d "'\"" || true)
        queue_file=$(printf '%s\n' "$cmdline" \
            | grep -oE -- "--queue [^ ]+" | awk '{print $2}' | tr -d "'\"" || true)
        if python3 - "${state_file:-}" "${queue_file:-}" "$title" "$season" "$target_root" "$MEDIA_SMB_ROOT" "$MEDIA_NFS_ROOT" >/dev/null 2>&1 <<'PY'
import csv, json, os, sys
sp, qp, title, season, root, smb, nfs = sys.argv[1:8]

def norm_root(p):
    p = os.path.normpath((p or "").strip())
    if not p or p == ".":
        return ""
    for pref in (smb.rstrip("/"), nfs.rstrip("/")):
        if pref and (p == pref or p.startswith(pref + "/")):
            return "<MEDIA>" + p[len(pref):]
    return p

want_title = (title or "").strip().casefold()
want_season = str(int(season)) if (season or "").isdigit() else (season or "").strip()
want_root = norm_root(root)

rows = []
if sp and os.path.isfile(sp):
    try:
        d = json.load(open(sp, encoding="utf-8"))
        rows.extend(d.get("queue") or [])
    except Exception:
        pass
if not rows and qp and os.path.isfile(qp):
    try:
        with open(qp, encoding="utf-8", newline="") as fh:
            rows.extend(csv.DictReader(fh))
    except Exception:
        pass

for q in rows:
    qt = str(q.get("title") or "").strip().casefold()
    qs_raw = str(q.get("season") or "").strip()
    qs = str(int(qs_raw)) if qs_raw.isdigit() else qs_raw
    qr = norm_root(str(q.get("target_root") or ""))
    if want_root and qr and qr == want_root:
        sys.exit(0)
    if want_title and qt == want_title and (not want_season or not qs or qs == want_season):
        sys.exit(0)
sys.exit(1)
PY
        then
            printf '\033[33mWARNING: another burndvd/ripqueue (pid %s) is already ripping %s (S%02d).\033[0m\n' \
                "$pid" "$title" "$((10#$season))"
            printf '\033[33m  Set an explicit non-overlapping Episode start for Disc 2+ so both drives do not target the same episode slots.\033[0m\n'
            return 0
        fi
    done
}

STATE=$(mktemp -t burndvd-state.XXXX.json)
rm -f "$STATE"

for arg in "$@"; do
    if [ "$arg" = "--queue" ]; then
        exec caffeinate -dimsu "$RIPQUEUE_PY" \
            ${RIPQUEUE_MODE_ARGS[@]+"${RIPQUEUE_MODE_ARGS[@]}"} "$@"
    fi
done

DRIVE_CLAIM_DIR="$HOME/.cache/burndvd/drive-claims"
mkdir -p "$DRIVE_CLAIM_DIR"
DEVICE=""
DISC_INDEX=""
DRUTIL_INDEX=""
DRIVE_SERIAL=""
DISC_TYPE=""

MAKEMKVCON_BIN=""
if [ -n "${BURNDVD_MAKEMKVCON:-}" ]; then
    [ -x "$BURNDVD_MAKEMKVCON" ] && MAKEMKVCON_BIN="$BURNDVD_MAKEMKVCON"
elif command -v makemkvcon >/dev/null 2>&1; then
    MAKEMKVCON_BIN=$(command -v makemkvcon)
elif [ "$(command -v drutil 2>/dev/null || true)" = "/usr/bin/drutil" ] \
    && [ -x "/Applications/MakeMKV.app/Contents/MacOS/makemkvcon" ]; then
    MAKEMKVCON_BIN="/Applications/MakeMKV.app/Contents/MacOS/makemkvcon"
fi

claim_is_active() {
    local cdir="$1" claim_pid claim_state
    [ -d "$cdir" ] || return 1
    claim_pid=$(cat "$cdir/pid" 2>/dev/null || true)
    if [ -n "$claim_pid" ] && [[ "$claim_pid" =~ ^[0-9]+$ ]] && kill -0 "$claim_pid" 2>/dev/null; then
        return 0
    fi
    claim_state=$(cat "$cdir/state" 2>/dev/null || true)
    if [ -n "$claim_state" ] && pgrep -if "python.*(ripqueue\.py|burndvd-queue).*$claim_state" >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

BUSY_DEVS=$( { for p in $(pgrep -f makemkvcon 2>/dev/null || true); do lsof -p "$p" 2>/dev/null | grep -oE '/dev/r?disk[0-9]+' || true; done | grep -oE 'disk[0-9]+' | sort -u; } || true )

ENUM_ROWS=$(python3 - "${MAKEMKVCON_BIN:-}" "$DRIVE_CLAIM_DIR" "${BUSY_DEVS:-}" <<'PY'
import csv, json, os, re, subprocess, sys
from pathlib import Path

mkv_bin = (sys.argv[1] or "").strip()
claim_dir_arg = (sys.argv[2] or "").strip()
busy_devs_arg = sys.argv[3] if len(sys.argv) > 3 else ""

RIPQUEUE_RE = re.compile(r"(?:ripqueue\.py|burndvd-queue)\b")
DEVICE_ARG_RE = re.compile(r"--device(?:=|\s+)disc:(\d+)\b")
QUEUE_ARG_RE = re.compile(r"--queue(?:=|\s+)(\S+)")
MAKEMKV_PROC_RE = re.compile(r"\bmakemkvcon\b")
MAKEMKV_DISC_RE = re.compile(r"\b(?:info|mkv)\s+disc:(\d+)\b")
DUMMY_DISC_IDX = 9999

def norm_dev_short(raw):
    m = re.match(r"^(?:/dev/)?r?(disk\d+)$", (raw or "").strip())
    return m.group(1) if m else ""

def parse_disc_idx(raw):
    s = (raw or "").strip()
    if s.startswith("disc:"):
        s = s[5:]
    return int(s) if re.fullmatch(r"\d+", s) else None

def pid_alive(pid):
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False

def read_txt(p):
    try:
        return p.read_text(encoding="utf-8").strip()
    except OSError:
        return ""

def active_procs():
    try:
        r = subprocess.run(["ps", "-Ao", "pid=,args="], capture_output=True, text=True, timeout=5)
    except Exception:
        return []
    if r.returncode != 0:
        return []
    rows = []
    for line in (r.stdout or "").splitlines():
        m = re.match(r"^\s*(\d+)\s+(.+)$", line)
        if m:
            rows.append((int(m.group(1)), m.group(2).strip()))
    return rows

def vol_for_dev(dev):
    try:
        r = subprocess.run(["diskutil", "info", f"/dev/{dev}"], capture_output=True, text=True, timeout=5)
        for line in (r.stdout or "").splitlines():
            if "Volume Name" in line and ":" in line:
                return line.split(":", 1)[1].strip()
    except Exception:
        pass
    return ""

def queue_volume_from_state_or_cmd(state_path, cmd):
    qp = ""
    if cmd:
        qm = QUEUE_ARG_RE.search(cmd)
        if qm:
            qp = qm.group(1).strip("'\"")
    notes_list = []
    if state_path and os.path.isfile(state_path):
        try:
            d = json.load(open(state_path, encoding="utf-8"))
            for q in (d.get("queue") or []):
                if isinstance(q, dict) and q.get("notes"):
                    notes_list.append(str(q["notes"]))
        except Exception:
            pass
    if not notes_list and qp and os.path.isfile(qp):
        try:
            with open(qp, encoding="utf-8", newline="") as fh:
                for q in csv.DictReader(fh):
                    if q.get("notes"):
                        notes_list.append(str(q["notes"]))
        except Exception:
            pass
    for notes in notes_list:
        vm = re.search(r"auto-built from\s+(\S+)", notes)
        if vm:
            return vm.group(1).strip()
    return ""

procs = active_procs()
busy_devs = {norm_dev_short(d) for d in busy_devs_arg.splitlines() if norm_dev_short(d)}
busy_serials_cf = set()
busy_discs = set()
busy_volumes_cf = set()

if claim_dir_arg and os.path.isdir(claim_dir_arg):
    try:
        claim_entries = sorted(Path(claim_dir_arg).iterdir(), key=lambda p: p.name)
    except OSError:
        claim_entries = []
    for entry in claim_entries:
        if not entry.is_dir() or not entry.name.endswith(".claim"):
            continue
        pid_txt = read_txt(entry / "pid")
        c_pid = int(pid_txt) if pid_txt.isdigit() else None
        c_state = read_txt(entry / "state")
        c_dev = norm_dev_short(read_txt(entry / "dev"))
        c_serial = read_txt(entry / "serial")
        c_disc = parse_disc_idx(read_txt(entry / "disc"))

        stem = entry.name[:-len(".claim")]
        if stem.startswith("dev-") and not c_dev:
            c_dev = norm_dev_short(stem[len("dev-"):])
        elif stem.startswith("serial-") and not c_serial:
            c_serial = stem[len("serial-"):].strip()
        elif stem.startswith("disc-") and c_disc is None:
            c_disc = parse_disc_idx(stem[len("disc-"):])

        matching_cmd = None
        if c_state:
            for _ppid, cmd in procs:
                if RIPQUEUE_RE.search(cmd) and c_state in cmd:
                    matching_cmd = cmd
                    break

        is_active = (c_pid is not None and pid_alive(c_pid)) or (matching_cmd is not None)
        if not is_active:
            continue

        if c_disc is None and matching_cmd is not None:
            dm = DEVICE_ARG_RE.search(matching_cmd)
            if dm:
                c_disc = int(dm.group(1))
        if c_dev:
            busy_devs.add(c_dev)
        if c_serial:
            busy_serials_cf.add(c_serial.casefold())
        if c_disc is not None and c_disc != DUMMY_DISC_IDX:
            busy_discs.add(c_disc)
        qvol = queue_volume_from_state_or_cmd(c_state, matching_cmd or "")
        if qvol:
            busy_volumes_cf.add(qvol.casefold())

my_pid = os.getpid()
for ppid, cmd in procs:
    if ppid == my_pid:
        continue
    if RIPQUEUE_RE.search(cmd):
        dm = DEVICE_ARG_RE.search(cmd)
        if dm:
            k = int(dm.group(1))
            if k != DUMMY_DISC_IDX:
                busy_discs.add(k)
        qvol = queue_volume_from_state_or_cmd("", cmd)
        if qvol:
            busy_volumes_cf.add(qvol.casefold())
    elif MAKEMKV_PROC_RE.search(cmd) and not re.search(r"\binfo\s+list\b", cmd):
        dm = MAKEMKV_DISC_RE.search(cmd)
        if dm:
            k = int(dm.group(1))
            if k != DUMMY_DISC_IDX:
                busy_discs.add(k)

def parse_drv_line(line):
    if ":" not in line:
        return None
    tag, rest = line.split(":", 1)
    if tag != "DRV":
        return None
    out, cur, in_q, i = [], "", False, 0
    while i < len(rest):
        c = rest[i]
        if c == '"':
            if in_q and i + 1 < len(rest) and rest[i + 1] == '"':
                cur += '"'
                i += 2
                continue
            in_q = not in_q
        elif c == "," and not in_q:
            out.append(cur)
            cur = ""
        else:
            cur += c
        i += 1
    out.append(cur)
    if len(out) < 7:
        return None
    try:
        idx = int(out[0])
        state = int(out[1])
    except ValueError:
        return None
    desc = out[4].strip()
    vol = out[5].strip()
    raw_dev = out[6].strip()
    dev = norm_dev_short(raw_dev)
    toks = desc.split()
    last_tok = toks[-1] if toks else ""
    serial = last_tok if (len(last_tok) >= 6 and last_tok.isalnum()) else ""
    return (idx, state, desc, serial, vol, dev)

all_drutil_indices = []
drutil_by_dev = {}
drutil_loaded = []
try:
    dl = subprocess.run(["drutil", "list"], capture_output=True, text=True, timeout=10)
    for line in (dl.stdout or "").splitlines():
        m = re.match(r"^\s*(\d+)\s+\S", line)
        if not m:
            continue
        ix = m.group(1)
        if ix not in all_drutil_indices:
            all_drutil_indices.append(ix)
        try:
            st = subprocess.run(["drutil", "status", "-drive", ix], capture_output=True, text=True, timeout=10)
        except Exception:
            continue
        out = st.stdout or ""
        if "No Media Inserted" in out:
            continue
        dm = re.search(r"Name:\s*/dev/(disk\d+)", out)
        if not dm:
            continue
        dev = dm.group(1)
        tm = re.search(r"Type:\s*(\S+)", out)
        dtype = tm.group(1) if tm else ""
        drutil_by_dev[dev] = (ix, dtype)
        dnum = int(dev[4:])
        drutil_loaded.append((dnum, int(ix), dev, ix, dtype))
except Exception:
    pass

mkv_rows = []
unmatched_mkv = []
matched_devs = set()
if mkv_bin:
    try:
        r = subprocess.run([mkv_bin, "-r", "info", "list"], capture_output=True, text=True, timeout=15)
        for line in (r.stdout or "").splitlines():
            parsed = parse_drv_line(line.strip())
            if not parsed:
                continue
            idx, state, desc, serial, vol, dev = parsed
            if state != 2:
                continue
            if dev:
                ix, dtype = drutil_by_dev.get(dev, (str(idx + 1), ""))
                is_busy = (
                    (dev in busy_devs)
                    or (bool(serial) and serial.casefold() in busy_serials_cf)
                    or (idx in busy_discs)
                )
                mkv_rows.append((dev, str(idx), ix, serial, dtype, vol, "1" if is_busy else "0"))
                matched_devs.add(dev)
            else:
                unmatched_mkv.append((idx, serial, vol))
    except Exception:
        pass

if unmatched_mkv:
    rem_drutil = [item for item in drutil_loaded if item[2] not in matched_devs]
    rem_vols = {item[2]: vol_for_dev(item[2]) for item in rem_drutil}
    still_mkv = []
    for idx, serial, vol in unmatched_mkv:
        matched_item = None
        if vol:
            hits = [it for it in rem_drutil if rem_vols.get(it[2], "").casefold() == vol.casefold()]
            if len(hits) == 1:
                matched_item = hits[0]
        if matched_item is not None:
            _, _, dev, ix, dtype = matched_item
            is_busy = (
                (dev in busy_devs)
                or (bool(serial) and serial.casefold() in busy_serials_cf)
                or (idx in busy_discs)
            )
            mkv_rows.append((dev, str(idx), ix, serial, dtype, vol, "1" if is_busy else "0"))
            matched_devs.add(dev)
            rem_drutil = [it for it in rem_drutil if it[2] != dev]
        else:
            still_mkv.append((idx, serial, vol))
    if len(still_mkv) == 1 and len(rem_drutil) == 1:
        idx, serial, vol = still_mkv[0]
        _, _, dev, ix, dtype = rem_drutil[0]
        is_busy = (
            (dev in busy_devs)
            or (bool(serial) and serial.casefold() in busy_serials_cf)
            or (idx in busy_discs)
        )
        mkv_rows.append((dev, str(idx), ix, serial, dtype, vol, "1" if is_busy else "0"))

SEP = "\x1f"
if mkv_rows:
    for row in mkv_rows:
        print(SEP.join(field.replace(SEP, " ") for field in row))
else:
    drutil_loaded.sort(key=lambda item: (item[0], item[1]))
    if busy_discs and busy_volumes_cf:
        for _, _, dev, _, _ in drutil_loaded:
            if dev not in busy_devs:
                v = vol_for_dev(dev)
                if v and v.casefold() in busy_volumes_cf:
                    busy_devs.add(dev)
    avail_drutil = []
    for item in drutil_loaded:
        _, _, dev, ix, dtype = item
        if dev in busy_devs:
            print(SEP.join((dev, "", ix, "", dtype, "", "1")))
        else:
            avail_drutil.append(item)
    if busy_discs:
        total_slots = max(len(all_drutil_indices), len(drutil_loaded), max(busy_discs) + 1)
        free_slots = [k for k in range(total_slots) if k not in busy_discs]
        if not free_slots:
            sys.stderr.write(
                "burndvd: MakeMKV drive enumeration unavailable and all detected disc slots "
                f"({sorted(busy_discs)}) are busy/claimed; refusing unsafe fallback.\n"
            )
        elif len(avail_drutil) <= len(free_slots):
            for slot_idx, (_, _, dev, ix, dtype) in zip(free_slots, avail_drutil):
                print(SEP.join((dev, str(slot_idx), ix, "", dtype, "", "0")))
        else:
            sys.stderr.write(
                "burndvd: MakeMKV drive enumeration unavailable while disc slot(s) "
                f"{sorted(busy_discs)} are busy and {len(avail_drutil)} loaded drive(s) remain "
                "unattributed; refusing to guess and risk clobbering the active rip.\n"
            )
    else:
        for rank, (_, _, dev, ix, dtype) in enumerate(avail_drutil):
            print(SEP.join((dev, str(rank), ix, "", dtype, "", "0")))
PY
)

AVAIL_DEVS=()
AVAIL_DISCS=()
AVAIL_DRUTILS=()
AVAIL_SERIALS=()
AVAIL_TYPES=()
AVAIL_VOLS=()
TARGET_FOUND=0
TARGET_BUSY=0
TARGET_NORM_DEV="${TARGET_DRIVE#/dev/}"
TARGET_NORM_DEV="${TARGET_NORM_DEV#r}"
TARGET_UPPER=$(printf '%s' "$TARGET_DRIVE" | tr '[:lower:]' '[:upper:]')

while IFS=$'\x1f' read -r _dev _discN _drutilIx _serial _dtype _vol _row_busy; do
    [ -z "$_dev" ] && continue
    _serial_upper=$(printf '%s' "$_serial" | tr '[:lower:]' '[:upper:]')
    if [ -n "$TARGET_DRIVE" ]; then
        if [ "$_dev" != "$TARGET_NORM_DEV" ] && { [ -z "$_serial_upper" ] || [ "$_serial_upper" != "$TARGET_UPPER" ]; }; then
            continue
        fi
        TARGET_FOUND=1
    fi
    _is_busy=0
    if [ "${_row_busy:-0}" = "1" ] || [ -z "$_discN" ]; then
        _is_busy=1
    fi
    if [ "$_is_busy" = "0" ] && printf '%s\n' "$BUSY_DEVS" | grep -qx "$_dev"; then
        _is_busy=1
    fi
    if [ "$_is_busy" = "0" ] && [ -n "$_serial" ] && claim_is_active "$DRIVE_CLAIM_DIR/serial-${_serial}.claim"; then
        _is_busy=1
    fi
    if [ "$_is_busy" = "0" ] && claim_is_active "$DRIVE_CLAIM_DIR/dev-${_dev}.claim"; then
        _is_busy=1
    fi
    if [ "$_is_busy" = "0" ] && [ -n "$_discN" ] && claim_is_active "$DRIVE_CLAIM_DIR/disc-${_discN}.claim"; then
        _is_busy=1
    fi
    if [ "$_is_busy" = "1" ]; then
        [ -n "$TARGET_DRIVE" ] && TARGET_BUSY=1
        continue
    fi
    AVAIL_DEVS+=("$_dev")
    AVAIL_DISCS+=("$_discN")
    AVAIL_DRUTILS+=("$_drutilIx")
    AVAIL_SERIALS+=("$_serial")
    AVAIL_TYPES+=("$_dtype")
    AVAIL_VOLS+=("$_vol")
done <<< "$ENUM_ROWS"

if [ "${#AVAIL_DEVS[@]}" -eq 0 ]; then
    if [ -n "$TARGET_DRIVE" ]; then
        if [ "$TARGET_BUSY" = "1" ]; then
            echo "burndvd: requested drive '$TARGET_DRIVE' is busy ripping." >&2
        else
            echo "burndvd: requested drive '$TARGET_DRIVE' not found or has no disc inserted." >&2
        fi
        exit 1
    fi
    n_drives=$( (drutil list 2>/dev/null | grep -cE '^[[:space:]]*[0-9]+[[:space:]]') || true )
    n_drives="${n_drives:-0}"
    if [ "$n_drives" -eq 0 ]; then
        echo "burndvd: no optical drive detected." >&2
    else
        echo "burndvd: no available drive — all $n_drives drive(s) either empty or busy ripping." >&2
        drutil list 2>/dev/null | head >&2
    fi
    exit 1
fi

CHOSEN_I=0
if [ "${#AVAIL_DEVS[@]}" -ge 2 ]; then
    echo "Multiple drives have discs inserted:"
    for _mi in "${!AVAIL_DEVS[@]}"; do
        _mdev="${AVAIL_DEVS[$_mi]}"
        _mser="${AVAIL_SERIALS[$_mi]}"
        _mvol="${AVAIL_VOLS[$_mi]}"
        if [ -z "$_mvol" ]; then
            _mvol=$( (diskutil info "/dev/$_mdev" 2>/dev/null \
                | awk -F: '/Volume Name/ {sub(/^[[:space:]]+/, "", $2); print $2; exit}') || true )
        fi
        if [ -n "$_mser" ]; then
            printf '  [%d] /dev/%s (%s) — %s\n' "$((_mi + 1))" "$_mdev" "$_mser" "${_mvol:-(unknown)}"
        else
            printf '  [%d] /dev/%s (disc:%s) — %s\n' "$((_mi + 1))" "$_mdev" "${AVAIL_DISCS[$_mi]}" "${_mvol:-(unknown)}"
        fi
    done
    prompt_value DRIVE_CHOICE "Select drive [1-${#AVAIL_DEVS[@]}] (default 1): " "1" 1
    if ! [[ "$DRIVE_CHOICE" =~ ^[0-9]+$ ]] || [ "$DRIVE_CHOICE" -lt 1 ] || [ "$DRIVE_CHOICE" -gt "${#AVAIL_DEVS[@]}" ]; then
        echo "burndvd: invalid drive selection '$DRIVE_CHOICE'." >&2
        exit 64
    fi
    CHOSEN_I=$((DRIVE_CHOICE - 1))
fi

dev="${AVAIL_DEVS[$CHOSEN_I]}"
discN="${AVAIL_DISCS[$CHOSEN_I]}"
idx="${AVAIL_DRUTILS[$CHOSEN_I]}"
serial="${AVAIL_SERIALS[$CHOSEN_I]}"
dtype="${AVAIL_TYPES[$CHOSEN_I]}"
if [ -n "$serial" ]; then
    drive_claim="$DRIVE_CLAIM_DIR/serial-${serial}.claim"
else
    drive_claim="$DRIVE_CLAIM_DIR/dev-${dev}.claim"
fi
if ! mkdir "$drive_claim" 2>/dev/null; then
    if claim_is_active "$drive_claim"; then
        echo "burndvd: drive /dev/$dev was just claimed by another burndvd process." >&2
        exit 1
    fi
    rm -rf "$drive_claim" 2>/dev/null || true
    if ! mkdir "$drive_claim" 2>/dev/null; then
        echo "burndvd: could not claim drive /dev/$dev." >&2
        exit 1
    fi
fi
DRIVE_CLAIM_HELD="$drive_claim"
echo "$$" > "$DRIVE_CLAIM_HELD/pid" 2>/dev/null || true
echo "$STATE" > "$DRIVE_CLAIM_HELD/state" 2>/dev/null || true
echo "/dev/$dev" > "$DRIVE_CLAIM_HELD/dev" 2>/dev/null || true
echo "$discN" > "$DRIVE_CLAIM_HELD/disc" 2>/dev/null || true
if [ -n "$serial" ]; then
    echo "$serial" > "$DRIVE_CLAIM_HELD/serial" 2>/dev/null || true
fi
DEVICE="$dev"
DISC_INDEX="$discN"
DRUTIL_INDEX="$idx"
DRIVE_SERIAL="$serial"
DISC_TYPE="$dtype"

export BURNDVD_DRUTIL_DRIVE="$DRUTIL_INDEX"
export BURNDVD_DRIVE_DEVICE="/dev/$DEVICE"
export BURNDVD_DRIVE_SERIAL="$DRIVE_SERIAL"

VOLUME=$( (diskutil info "/dev/$DEVICE" 2>/dev/null \
    | awk -F: '/Volume Name/ {sub(/^[[:space:]]+/, "", $2); print $2; exit}') || true )
if [ -z "${VOLUME:-}" ]; then
    echo "burndvd: no Volume Name from diskutil info /dev/$DEVICE (disc:$DISC_INDEX)." >&2
    echo "         Insert disc and wait for the drive to spin up, then retry." >&2
    exit 1
fi

SIZE_GB=$( (drutil status -drive "$DRUTIL_INDEX" 2>/dev/null \
    | awk '/Space Used:/ {for(i=1;i<=NF;i++) if($i ~ /GB$/) {sub("GB","",$i); printf "%d", $i+0.5; exit}}') || true )
if ! [[ "${SIZE_GB:-0}" =~ ^[0-9]+$ ]] || [ "${SIZE_GB:-0}" = "0" ]; then
    if [ -d "/Volumes/$VOLUME" ]; then
        SIZE_KB=$(df -k "/Volumes/$VOLUME" 2>/dev/null | awk 'NR==2 {print $3}')
        if [[ "${SIZE_KB:-0}" =~ ^[0-9]+$ ]]; then
            SIZE_GB=$(( SIZE_KB / 1024 / 1024 ))
        fi
    fi
fi
if ! [[ "${SIZE_GB:-0}" =~ ^[0-9]+$ ]]; then
    echo "burndvd: could not read disc size for /dev/$DEVICE (volume: $VOLUME)." >&2
    exit 1
fi

case "$DISC_TYPE" in
    DVD-ROM*|DVD-R*|DVD+R*|DVD-RW*|DVD+RW*) DEFAULT_FORMAT="DVD" ;;
    *)
        if [ "$SIZE_GB" -gt 70 ]; then
            DEFAULT_FORMAT="4K"
        else
            DEFAULT_FORMAT="BD"
        fi
        ;;
esac

_DEFAULTS_NAS_ROOT=$(resolve_nas_root)
{ read -r DEFAULT_TYPE; read -r DEFAULT_SEASON; read -r DEFAULT_TITLE; } \
    < <(run_metadata defaults "$VOLUME" \
        --tv-root "$_DEFAULTS_NAS_ROOT/TV Shows" \
        --tv-root "$_DEFAULTS_NAS_ROOT/TV Shows 4K")

cat <<EOF
Detected disc:
  device:  /dev/$DEVICE
  volume:  $VOLUME
  size:    ~${SIZE_GB} GiB
  format:  $DEFAULT_FORMAT (auto)

EOF

prompt_value TITLE "Title (include year): [$DEFAULT_TITLE] " "$DEFAULT_TITLE" 1
prompt_value TYPE "Type [$DEFAULT_TYPE]: " "$DEFAULT_TYPE" 1
[ "$TYPE" = "tv" ] && TYPE="tv-season"

if [ "$TYPE" = "movie" ]; then
    TITLE=$(run_metadata normalize-movie "$TITLE")
    if ! run_metadata has-year "$TITLE"; then
